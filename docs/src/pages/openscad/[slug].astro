---
import ModelPage from '../../components/ModelPage.astro';
import modelCatalog from '../../generated/model-catalog';

export function getStaticPaths() {
  return modelCatalog.groups
    .filter((group) => group.flatRouteAvailable)
    .map((group) => ({
    params: { slug: group.slug },
    props: { group },
    }));
}

const { group } = Astro.props;
---

<ModelPage
  title={group.title}
  groups={[group]}
  canonicalPath={group.directory === '.' ? undefined : group.routePath}
/>
