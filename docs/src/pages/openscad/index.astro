---
import Layout from '../../layouts/Layout.astro';
import modelCatalog from '../../generated/model-catalog';
---

<Layout title="OpenSCAD models" backHref="/3d_models/" backLabel="Home" activeSection="openscad">
  <main>
    <h1>OpenSCAD models</h1>
    <p>Collections discovered from eligible OpenSCAD source/STL pairs.</p>

    <nav aria-label="OpenSCAD model collections">
      <ul>
        {modelCatalog.groups.map((group) => (
          <li>
            <a href={`/3d_models/openscad/${group.slug}`}>{group.title}</a>
            <span> ({group.items.length} STL)</span>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</Layout>
