---
import Layout from '../layouts/Layout.astro';
import STLViewerGallery from '../components/STLViewerGallery';

const stlFiles = [
  '/3d_models/build123d/simple/mug.stl',
  '/3d_models/build123d/simple/gridfinity_1x1.stl',
  '/3d_models/build123d/simple/honeycomb_wall_8x8.stl',
  '/3d_models/build123d/simple/cable_winder.stl',
];
---

<Layout title="build123d models" backHref="/3d_models/" backLabel="Home" activeSection="build123d">
	<main>
	  <h1>build123d models</h1>
	  <nav aria-label="build123d model pages">
	    <ul>
	      <li><a href="/3d_models/mug">Mug</a></li>
	      <li><a href="/3d_models/gridfinity_1x1">Gridfinity 1x1</a></li>
	    </ul>
	  </nav>

	  <STLViewerGallery client:only="react" urls={stlFiles} />
	</main>
</Layout>
