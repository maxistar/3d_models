---
import Layout from '../layouts/Layout.astro';
import STLViewerComponent from '../components/STLViewerComponent.jsx';
const modelUrl = '/3d_models/openscad/blocknote/blocknote_cover.stl';

---

<Layout title="Home" activeSection="home">
	<main>
		<h1>3D models</h1>
		<p>Parametric models for printing and making.</p>
		<STLViewerComponent client:only="react" url={modelUrl} />
	</main>
</Layout>
