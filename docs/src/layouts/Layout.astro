---
const {
	title = 'Maxistar 3D models',
	backHref,
	backLabel,
	activeSection: requestedSection,
} = Astro.props;

const currentPath = Astro.url.pathname;
const activeSection = requestedSection ?? (
	currentPath === '/3d_models/'
		? 'home'
		: currentPath.startsWith('/3d_models/openscad')
			? 'openscad'
			: currentPath.startsWith('/3d_models/build123d')
				? 'build123d'
				: undefined
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ? `${title} | Maxistar 3D models` : 'Maxistar 3D models'}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<div class="site-header__inner">
					<a class="site-brand" href="/3d_models/">Maxistar · 3D models</a>
					<nav aria-label="Primary navigation" class="primary-nav">
						<a
							href="/3d_models/"
							aria-current={activeSection === 'home' ? 'page' : undefined}
							class:list={{ active: activeSection === 'home' }}
						>Home</a>
						<a
							href="/3d_models/openscad/"
							aria-current={activeSection === 'openscad' ? 'page' : undefined}
							class:list={{ active: activeSection === 'openscad' }}
						>OpenSCAD</a>
						<a
							href="/3d_models/build123d/"
							aria-current={activeSection === 'build123d' ? 'page' : undefined}
							class:list={{ active: activeSection === 'build123d' }}
						>build123d</a>
					</nav>
				</div>
			</header>

			<div class="site-content">
				{backHref && (
					<p class="back-link">
						<a href={backHref}>← {backLabel ?? 'Back'}</a>
					</p>
				)}
				<slot />
			</div>

			<footer class="site-footer">
				<div class="site-footer__inner">
					<span>Find more models:</span>
					<nav aria-label="External model profiles">
						<a
							href="https://www.printables.com/@maxistar_3544573"
							target="_blank"
							rel="noreferrer noopener"
						>Printables</a>
						<span aria-hidden="true">·</span>
						<a
							href="https://www.thingiverse.com/maxistar/designs"
							target="_blank"
							rel="noreferrer noopener"
						>Thingiverse</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #202124;
		background: #f7f7f5;
		font-synthesis: none;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		min-height: 100vh;
		line-height: 1.5;
		background: #f7f7f5;
	}

	.site-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.site-header {
		border-bottom: 1px solid #deded8;
		background: rgba(255, 255, 255, 0.78);
	}

	.site-header__inner,
	.site-content,
	.site-footer__inner {
		width: min(calc(100% - 2rem), 960px);
		margin: 0 auto;
	}

	.site-header__inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.9rem 0;
	}

	.site-brand {
		color: #202124;
		font-weight: 650;
		text-decoration: none;
		white-space: nowrap;
	}

	.primary-nav,
	.site-footer__inner,
	.site-footer nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.primary-nav a,
	.site-footer a {
		color: #5d5d57;
		text-decoration: none;
	}

	.primary-nav a {
		padding: 0.2rem 0;
		border-bottom: 2px solid transparent;
	}

	.primary-nav a:hover,
	.primary-nav a.active,
	.site-footer a:hover {
		color: #202124;
	}

	.primary-nav a.active {
		border-bottom-color: #202124;
	}

	.site-content {
		box-sizing: border-box;
		flex: 1;
		padding: 1.25rem 0 3rem;
	}

	.back-link {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
	}

	.site-content a:focus-visible,
	.site-header a:focus-visible,
	.site-footer a:focus-visible {
		outline: 3px solid #8ab4f8;
		outline-offset: 3px;
		border-radius: 2px;
	}

	.site-footer {
		border-top: 1px solid #deded8;
		color: #777770;
		font-size: 0.9rem;
	}

	.site-footer__inner {
		justify-content: center;
		padding: 1rem 0;
	}

	@media (max-width: 640px) {
		.site-header__inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		.site-content {
			padding-top: 1rem;
		}
	}
</style>
